+def _expand_motion_files(motion_file: str | Sequence[str]) -> list[str]:
+  """A path, a directory of ``*.npz``, a glob, or a list of any of these."""
+  items = [motion_file] if isinstance(motion_file, str) else list(motion_file)
+  paths: list[str] = []
+  for item in items:
+    item = os.path.expanduser(item)
+    if os.path.isdir(item):
+      found = sorted(glob.glob(os.path.join(item, "*.npz")))
+    elif glob.has_magic(item):
+      found = sorted(glob.glob(item))
+    else:
+      found = [item]
+    if not found:
+      raise FileNotFoundError(f"No motion files match {item!r}")
+    paths.extend(found)
+  return paths
