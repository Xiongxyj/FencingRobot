+++ b/src/mjlab/utils/forward_kinematics.py
@@ -0,0 +1,145 @@
+"""Differentiable forward kinematics of an articulated entity, in torch.
+
+Follows MuJoCo's ``mj_kinematics`` for a free-floating tree of hinge joints (a
+hinge turns by ``qpos - qpos0`` about its axis through its anchor) and propagates
+the body twist down the tree. Returns the world-frame pose and twist of each body
+frame origin, i.e. what mjlab exposes as ``body_link_{pos,quat,lin_vel,ang_vel}_w``.
+Batched over any leading dimensions and differentiable in every input.
+
+[FencingRobot] Not part of upstream mjlab v1.5.0: written for the official
+SuperMimic code, which imports it from the unreleased ``mjlab_research`` fork.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import mujoco
+import torch
+
+from mjlab.utils.lab_api.math import quat_apply, quat_from_angle_axis, quat_mul
+
+
+class ForwardKinematics:
+  """Forward kinematics of one entity for a subset of its bodies.
+
+  Args:
+    mj_model: Compiled model that contains the entity.
+    body_ids: The entity's global body ids in entity order. Row 0 is the root,
+      which must carry the entity's free joint.
+    joint_q_adr: qpos addresses of the entity's joints in ``joint_pos`` column
+      order (``joint_vel`` uses the same column order).
+    body_indexes: Entity rows of the bodies to return, in output order.
+  """
+
+  def __init__(
+    self,
+    mj_model: mujoco.MjModel,
+    body_ids: Sequence[int] | torch.Tensor,
+    joint_q_adr: Sequence[int] | torch.Tensor,
+    body_indexes: Sequence[int] | torch.Tensor,
+    device: str | torch.device = "cpu",
+    dtype: torch.dtype = torch.float32,
+  ) -> None:
+    ids = [int(b) for b in body_ids]
+    row_of = {b: r for r, b in enumerate(ids)}
+    col_of = {int(a): c for c, a in enumerate(joint_q_adr)}
+    root = ids[0]
+    root_jnt = int(mj_model.body_jntadr[root])
+    if (
+      int(mj_model.body_jntnum[root]) != 1
+      or int(mj_model.jnt_type[root_jnt]) != mujoco.mjtJoint.mjJNT_FREE
+    ):
+      raise ValueError("The entity root must carry exactly one free joint.")
+
+    parents: list[int] = []
+    cols: list[int] = []
+    pos, quat, axis, anchor, qpos0 = [], [], [], [], []
+    for b in ids[1:]:
+      parent = int(mj_model.body_parentid[b])
+      if parent not in row_of or row_of[parent] >= row_of[b]:
+        raise ValueError(f"Body {b}: its parent must precede it in the entity.")
+      parents.append(row_of[parent])
+      pos.append(mj_model.body_pos[b].tolist())
+      quat.append(mj_model.body_quat[b].tolist())
+      njnt = int(mj_model.body_jntnum[b])
+      if njnt > 1:
+        raise ValueError(f"Body {b}: at most one joint per body is supported.")
+      if njnt == 1:
+        j = int(mj_model.body_jntadr[b])
+        if int(mj_model.jnt_type[j]) != mujoco.mjtJoint.mjJNT_HINGE:
+          raise ValueError(f"Body {b}: only hinge joints are supported.")
+        qadr = int(mj_model.jnt_qposadr[j])
+        cols.append(col_of[qadr])
+        axis.append(mj_model.jnt_axis[j].tolist())
+        anchor.append(mj_model.jnt_pos[j].tolist())
+        qpos0.append(float(mj_model.qpos0[qadr]))
+      else:
+        cols.append(-1)
+        axis.append([0.0, 0.0, 1.0])
+        anchor.append([0.0, 0.0, 0.0])
+        qpos0.append(0.0)
+
+    def t(x) -> torch.Tensor:
+      return torch.tensor(x, dtype=dtype, device=device)
+
+    self._parents = parents
+    self._cols = cols
+    self._pos, self._quat, self._axis, self._anchor = t(pos), t(quat), t(axis), t(anchor)
+    self._qpos0 = t(qpos0)
+    self.body_indexes = [int(i) for i in body_indexes]
+    self.num_bodies = len(self.body_indexes)
+
+  def __call__(
+    self,
+    root_pos: torch.Tensor,
+    root_quat: torch.Tensor,
+    joint_pos: torch.Tensor,
+    root_lin_vel: torch.Tensor,
+    root_ang_vel: torch.Tensor,
+    joint_vel: torch.Tensor,
+  ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """World-frame body states from the root state and joint state.
+
+    Args:
+      root_pos, root_quat: Root body origin position and orientation (w, x, y, z),
+        shapes ``(..., 3)`` and ``(..., 4)``.
+      joint_pos, joint_vel: Shape ``(..., J)``, in ``joint_q_adr`` column order.
+      root_lin_vel, root_ang_vel: World-frame twist of the root body origin,
+        shape ``(..., 3)``.
+
+    Returns:
+      ``(pos (..., B, 3), quat (..., B, 4), lin_vel (..., B, 3),
+      ang_vel (..., B, 3))`` for the requested bodies.
+    """
+    xpos, xquat, lin, ang = [root_pos], [root_quat], [root_lin_vel], [root_ang_vel]
+    for i, (p, c) in enumerate(zip(self._parents, self._cols, strict=True)):
+      xp, qp, vp, wp = xpos[p], xquat[p], lin[p], ang[p]
+      x = xp + quat_apply(qp, self._pos[i].expand_as(xp))
+      q = quat_mul(qp, self._quat[i].expand_as(qp))
+      v_extra = None
+      w = wp
+      if c >= 0:
+        local_anchor = self._anchor[i].expand_as(xp)
+        local_axis = self._axis[i].expand_as(xp)
+        anchor_w = x + quat_apply(q, local_anchor)
+        angle = joint_pos[..., c] - self._qpos0[i]
+        q = quat_mul(q, quat_from_angle_axis(angle, local_axis))
+        x = anchor_w - quat_apply(q, local_anchor)
+        w_joint = quat_apply(q, local_axis) * joint_vel[..., c : c + 1]
+        w = wp + w_joint
+        v_extra = torch.linalg.cross(w_joint, x - anchor_w, dim=-1)
+      v = vp + torch.linalg.cross(wp, x - xp, dim=-1)
+      if v_extra is not None:
+        v = v + v_extra
+      xpos.append(x)
+      xquat.append(q)
+      lin.append(v)
+      ang.append(w)
+    rows = self.body_indexes
+    return (
+      torch.stack([xpos[r] for r in rows], dim=-2),
+      torch.stack([xquat[r] for r in rows], dim=-2),
+      torch.stack([lin[r] for r in rows], dim=-2),
+      torch.stack([ang[r] for r in rows], dim=-2),
+    )
